# ========================
# JAL-RAKSHAK EDGE .gitignore
# ========================

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log*
*.tgz

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.secret

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/
env/
*.whl

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Build & Output ---
coverage/
*.log
JAL-RAKSHAK-frontend/dist/

# --- Vision Edge / ML Artifacts ---
# Keep model weights in repo (< 100MB each), but exclude:
vision-edge/model/*.onnx
vision-edge/model/*.engine
vision-edge/model/*.trt
vision-edge/model/export/
vision-edge/runs/
vision-edge/datasets/
*.mp4
*.avi
*.mkv

# --- PipeGen / TensorRT Generated ---
vision-edge/pipegen/*.engine
vision-edge/pipegen/output/
*.plan

# --- Docker / Containers ---
docker-compose.override.yml

# --- Misc ---
*.bak
*.tmp
*.cache
.pytest_cache/
