// ============================================================
// WATER LEVEL SETTINGS
// ============================================================

// Distance from HC-SR04 sensor to the bottom of the tank/channel.
// CHANGE THIS VALUE according to your actual setup.

const float WATER_REFERENCE_HEIGHT = 200.0;

// HC-SR04 operating limits
const float MIN_DISTANCE = 2.0;
const float MAX_DISTANCE = 200.0;


// ============================================================
// RISK SETTINGS
// ============================================================

const float HIGH_RISK = 70.0;
const float CRITICAL_RISK = 85.0;


// ============================================================
// BUZZER TIMING
// ============================================================

const unsigned long BUZZER_BEEP_INTERVAL = 500;   // ms between on/off toggles


// ============================================================
// VARIABLES
// ============================================================

// Ultrasonic
float distanceCM = 0.0;
bool sensorError = false;   // flags an HC-SR04 timeout/no-echo reading

// Water
float waterLevel = 0.0;
float previousWaterLevel = 0.0;

// Water behavior
float rateOfChange = 0.0;

// Temperature
float temperatureC = 0.0;

// Rain
int rainAnalog = 0;
bool rainDetected = false;

// Vibration
bool vibrationDetected = false;

// Risk
float riskScore = 0.0;
String riskStatus = "LOW";

// LCD alert flashing
bool showAlertScreen = false;

// Buzzer state
bool buzzerOn = false;
unsigned long lastBuzzerToggle = 0;


// ============================================================
// TIMING
// ============================================================

unsigned long previousTime = 0;

unsigned long lastThingSpeakUpdate = 0;
unsigned long lastBackendUpdate = 0;
unsigned long lastSMS = 0;

const unsigned long SENSOR_INTERVAL = 3000;
const unsigned long THINGSPEAK_INTERVAL = 15000;
const unsigned long BACKEND_INTERVAL = 5000;
const unsigned long SMS_COOLDOWN = 60000;


// ============================================================
// READ HC-SR04
// ============================================================

float readDistance()
{
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duration == 0)
  {
    // no echo received -> treat as a sensor error instead
    // of silently reporting an empty tank.
    sensorError = true;
    return MAX_DISTANCE;
  }

  sensorError = false;

  float distance = duration * 0.0343 / 2.0;

  if (distance < MIN_DISTANCE)
  {
    distance = MIN_DISTANCE;
  }

  if (distance > MAX_DISTANCE)
  {
    distance = MAX_DISTANCE;
  }

  return distance;
}


// ============================================================
// CALCULATE WATER LEVEL
// ============================================================

float calculateWaterLevel(float distance)
{
  float level = WATER_REFERENCE_HEIGHT - distance;

  if (level < 0)
  {
    level = 0;
  }

  if (level > WATER_REFERENCE_HEIGHT)
  {
    level = WATER_REFERENCE_HEIGHT;
  }

  return level;
}


// ============================================================
// READ LM35
// ============================================================

float readTemperature()
{
  int adcValue = analogRead(LM35_PIN);

  /*
     ESP32 ADC reference is approximately 3.3 V.

     LM35:
     10 mV = 1 degree Celsius

     Temperature:
     Voltage x 100
  */

  float voltage = (adcValue / 4095.0) * 3.3;

  float tempC = voltage * 100.0;

  return tempC;
}


// ============================================================
// READ RAIN SENSOR
// ============================================================

void readRainSensor()
{
  rainAnalog = analogRead(RAIN_AO);

  /*
     Analog-only reading: lower value generally means MORE
     water on the sensor plate (wetter = more conductive).
     Tune RAIN_THRESHOLD to your specific module/board.
  */

  const int RAIN_THRESHOLD = 2500;

  rainDetected = (rainAnalog < RAIN_THRESHOLD);
}


// ============================================================
// READ VIBRATION SENSOR (SW-420)
// ============================================================

void readVibrationSensor()
{
  /*
     SW-420 digital output: most boards output HIGH briefly
     when vibration/shock exceeds the threshold set by the
     onboard potentiometer. If your module behaves inverted,
     flip this comparison.
  */

  vibrationDetected = (digitalRead(VIBRATION_PIN) == HIGH);
}


// ============================================================
// CALCULATE WATER RATE
// ============================================================

void calculateWaterRate(float currentLevel, float dt)
{
  if (dt <= 0)
  {
    rateOfChange = 0;
    return;
  }

  rateOfChange =
      (currentLevel - previousWaterLevel) / dt;
}


// ============================================================
// CALCULATE RISK SCORE
// ============================================================

float calculateRisk()
{
  /*
     Risk factors:

     Water level       = 40%
     Rate of change    = 25%
     Temperature       = 10%
     Rainfall          = 25%

     Vibration is reported separately (LCD/Serial/dashboard/
     backend) but does not currently feed into this score.
     Ask if you'd like it folded in with its own weight.

     This is a PROJECT RISK INDEX,
     not a scientifically calibrated flood probability.
  */


  // ----------------------------------------------------------
  // WATER LEVEL SCORE
  // ----------------------------------------------------------

  float levelScore =
      (waterLevel / WATER_REFERENCE_HEIGHT) * 100.0;

  levelScore =
      constrain(levelScore, 0.0, 100.0);


  // ----------------------------------------------------------
  // WATER RISE RATE SCORE
  // ----------------------------------------------------------

  float risingRate = rateOfChange;

  if (risingRate < 0)
  {
    risingRate = 0;
  }

  // 2 cm/sec or more = maximum rate score

  float rateScore =
      (risingRate / 2.0) * 100.0;

  rateScore =
      constrain(rateScore, 0.0, 100.0);


  // ----------------------------------------------------------
  // RAIN SCORE
  // ----------------------------------------------------------

  float rainScore = 0;

  if (rainDetected)
  {
    rainScore = 100;
  }


  // ----------------------------------------------------------
  // TEMPERATURE SCORE
  // ----------------------------------------------------------

  /*
     Temperature is included as a supporting environmental
     factor, not as the main flood indicator.

     Example:
     20C or lower -> low contribution
     40C or higher -> maximum contribution
  */

  float temperatureScore =
      ((temperatureC - 20.0) / 20.0) * 100.0;

  temperatureScore =
      constrain(temperatureScore, 0.0, 100.0);


  // ----------------------------------------------------------
  // FINAL RISK SCORE
  // ----------------------------------------------------------

  float score =
      (levelScore * 0.40) +
      (rateScore * 0.25) +
      (temperatureScore * 0.10) +
      (rainScore * 0.25);

  score =
      constrain(score, 0.0, 100.0);

  return score;
}


// ============================================================
// GET RISK STATUS
// ============================================================

String getRiskStatus(float score)
{
  if (score >= CRITICAL_RISK)
  {
    return "CRITICAL";
  }
  else if (score >= HIGH_RISK)
  {
    return "HIGH";
  }
  else if (score >= 40)
  {
    return "MEDIUM";
  }
  else
  {
    return "LOW";
  }
}


// ============================================================
// LCD DISPLAY
// ============================================================

void displayLCD()
{
  lcd.clear();

  // surface sensor faults on the LCD instead of showing
  // a misleading "0 cm / LOW risk" reading.
  if (sensorError)
  {
    lcd.setCursor(0, 0);
    lcd.print("Sensor Error!");

    lcd.setCursor(0, 1);
    lcd.print("Check HC-SR04");

    return;
  }

  bool alertActive =
      (riskStatus == "HIGH" || riskStatus == "CRITICAL");

  // ----------------------------------------------------------
  // ALERT SCREEN (only shown when risk is HIGH or CRITICAL,
  // alternating with the normal readings screen every refresh
  // so the alert flashes and stays noticeable).
  // ----------------------------------------------------------

  if (alertActive && showAlertScreen)
  {
    lcd.setCursor(0, 0);

    if (riskStatus == "CRITICAL")
    {
      lcd.print("!! CRITICAL !!");
    }
    else
    {
      lcd.print("!!  ALERT  !!");
    }

    lcd.setCursor(0, 1);
    lcd.print("Water:");
    lcd.print(waterLevel, 0);
    lcd.print("cm R:");
    lcd.print(riskScore, 0);
  }
  else
  {
    // --------------------------------------------------------
    // NORMAL READINGS SCREEN
    // --------------------------------------------------------

    lcd.setCursor(0, 0);
    lcd.print("L:");
    lcd.print(waterLevel, 0);
    lcd.print("cm ");

    lcd.print("T:");
    lcd.print(temperatureC, 1);

    lcd.setCursor(0, 1);

    if (alertActive)
    {
      // Still flag the alert even on the readings screen,
      // so it's visible on every refresh, not just every other one.
      lcd.print("ALERT! ");
      lcd.print(riskScore, 0);
    }
    else
    {
      lcd.print("Risk:");
      lcd.print(riskScore, 0);
      lcd.print(" ");
      lcd.print(riskStatus);
    }
  }

  // Flip the flag so the next refresh shows the other screen.
  showAlertScreen = !showAlertScreen;
}


// ============================================================
// BUZZER ALARM
// ============================================================
// Non-blocking beeping: toggles the buzzer on/off every
// BUZZER_BEEP_INTERVAL while risk is HIGH/CRITICAL, and stays
// silent otherwise. Called every loop() iteration so it never
// blocks sensor reads, LCD updates, or web requests.

void updateBuzzer()
{
  bool alertActive =
      (riskStatus == "HIGH" || riskStatus == "CRITICAL");

  if (!alertActive)
  {
    if (buzzerOn)
    {
      digitalWrite(BUZZER_PIN, LOW);
      buzzerOn = false;
    }
    return;
  }

  unsigned long now = millis();

  if (now - lastBuzzerToggle >= BUZZER_BEEP_INTERVAL)
  {
    lastBuzzerToggle = now;
    buzzerOn = !buzzerOn;
    digitalWrite(BUZZER_PIN, buzzerOn ? HIGH : LOW);
  }
}


