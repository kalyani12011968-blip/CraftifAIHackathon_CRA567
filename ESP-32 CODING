// ============================================================
// SEND SMS
// ============================================================

void sendSMS(String message)
{
  Serial.println("Sending SMS...");

  sim800.println("AT+CMGF=1");

  delay(1000);

  sim800.print("AT+CMGS=\"");
  sim800.print(phoneNumber);
  sim800.println("\"");

  delay(1000);

  sim800.print(message);

  delay(500);

  // CTRL + Z
  sim800.write(26);

  delay(5000);

  Serial.println("SMS sent.");
}


// ============================================================
// CHECK SMS ALERT
// ============================================================

void checkSMSAlert()
{
  unsigned long currentMillis = millis();

  if (currentMillis - lastSMS < SMS_COOLDOWN)
  {
    return;
  }

  if (riskScore >= HIGH_RISK)
  {
    String message = "";

    message += "JAL-RAKSHAK ALERT!\n";

    message += "Status: ";
    message += riskStatus;

    message += "\nRisk: ";
    message += String(riskScore, 0);
    message += "/100";

    message += "\nWater: ";
    message += String(waterLevel, 1);
    message += " cm";

    message += "\nTemp: ";
    message += String(temperatureC, 1);
    message += " C";

    message += "\nRate: ";
    message += String(rateOfChange, 2);
    message += " cm/s";

    message += "\nRain: ";
    message += rainDetected ? "YES" : "NO";

    message += "\nVibration: ";
    message += vibrationDetected ? "YES" : "NO";

    sendSMS(message);

    lastSMS = currentMillis;
  }
}


// ============================================================
// CONNECT TO WIFI
// ============================================================

void connectWiFi()
{
  Serial.println();
  Serial.println("Connecting to Wi-Fi...");

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED &&
         attempts < 20)
  {
    delay(500);

    Serial.print(".");

    attempts++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED)
  {
    Serial.println("Wi-Fi connected.");

    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
  }
  else
  {
    Serial.println("Wi-Fi connection failed.");
  }
}


// ============================================================
// SEND DATA TO JAL RAKSHAK BACKEND
// ============================================================

void sendToBackend()
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println("Backend: Wi-Fi not connected.");
    return;
  }

  HTTPClient http;

  http.begin(BACKEND_URL);
  http.addHeader("Content-Type", "application/json");

  String jsonData = "{";

  jsonData += "\"distance\":";
  jsonData += String(distanceCM, 2);

  jsonData += ",\"waterLevel\":";
  jsonData += String(waterLevel, 2);

  jsonData += ",\"temperature\":";
  jsonData += String(temperatureC, 2);

  jsonData += ",\"rainStatus\":\"";
  jsonData += rainDetected ? "RAIN DETECTED" : "NO RAIN";
  jsonData += "\"";

  // CHANGED: now reports the real vibration sensor reading
  // instead of a hardcoded 0.
  jsonData += ",\"vibration\":";
  jsonData += vibrationDetected ? "1" : "0";

  jsonData += "}";

  Serial.println();
  Serial.println("Sending data to Jal Rakshak Backend...");
  Serial.println(jsonData);

  int httpCode = http.POST(jsonData);

  if (httpCode > 0)
  {
    Serial.print("Backend response code: ");
    Serial.println(httpCode);

    String response = http.getString();

    Serial.print("Backend response: ");
    Serial.println(response);
  }
  else
  {
    Serial.print("Backend error: ");
    Serial.println(http.errorToString(httpCode));
  }

  http.end();
}


// ============================================================
// SEND DATA TO THINGSPEAK
// ============================================================

void sendToThingSpeak()
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println("ThingSpeak: Wi-Fi not connected.");

    return;
  }


  HTTPClient http;


  /*
     ThingSpeak fields:

     Field 1 = Water Level
     Field 2 = Temperature
     Field 3 = Rain Analog
     Field 4 = Water Rate
     Field 5 = Risk Score
     Field 6 = Rain Status
     Field 7 = Vibration Status
  */

  String url =
      "https://api.thingspeak.com/update?api_key=";

  url += THINGSPEAK_API_KEY;

  url += "&field1=";
  url += String(waterLevel, 2);

  url += "&field2=";
  url += String(temperatureC, 2);

  url += "&field3=";
  url += String(rainAnalog);

  url += "&field4=";
  url += String(rateOfChange, 3);

  url += "&field5=";
  url += String(riskScore, 0);

  url += "&field6=";
  url += rainDetected ? "1" : "0";

  url += "&field7=";
  url += vibrationDetected ? "1" : "0";


  Serial.println();
  Serial.println("Sending data to ThingSpeak...");

  http.begin(url);

  int httpCode = http.GET();

  if (httpCode > 0)
  {
    Serial.print("ThingSpeak response: ");
    Serial.println(httpCode);

    String response =
        http.getString();

    Serial.print("Entry ID: ");
    Serial.println(response);
  }
  else
  {
    Serial.print("ThingSpeak error: ");
    Serial.println(http.errorToString(httpCode));
  }

  http.end();
}


// ============================================================
// INITIALIZE SIM800L
// ============================================================

void initializeSIM800()
{
  Serial.println("Starting SIM800L...");

  sim800.begin(
    9600,
    SERIAL_8N1,
    SIM_RX,
    SIM_TX
  );

  delay(3000);

  sim800.println("AT");

  delay(1000);

  sim800.println("ATE0");

  delay(1000);

  sim800.println("AT+CMGF=1");

  delay(1000);

  Serial.println("SIM800L ready.");
}


// ============================================================
// WEB SERVER: DASHBOARD PAGE
// ============================================================
// Builds and serves a small self-refreshing HTML page showing
// the current sensor readings. Triggered whenever a browser
// requests "/" from the ESP32's IP address.

void handleRoot()
{
  String statusColor = "#2e7d32";   // green = LOW

  if (riskStatus == "MEDIUM")
  {
    statusColor = "#f9a825";        // amber
  }
  else if (riskStatus == "HIGH")
  {
    statusColor = "#ef6c00";        // orange
  }
  else if (riskStatus == "CRITICAL")
  {
    statusColor = "#c62828";        // red
  }

  String html = "<!DOCTYPE html><html><head>";
  html += "<meta http-equiv='refresh' content='3'>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
  html += "<title>JAL-RAKSHAK Dashboard</title>";
  html += "<style>";
  html += "body{font-family:Arial,Helvetica,sans-serif;background:#0f172a;color:#e2e8f0;";
  html += "margin:0;padding:20px;}";
  html += ".card{background:#1e293b;border-radius:12px;padding:16px 20px;margin-bottom:14px;";
  html += "box-shadow:0 2px 6px rgba(0,0,0,0.3);}";
  html += "h1{font-size:22px;margin-bottom:4px;}";
  html += ".sub{color:#94a3b8;font-size:13px;margin-bottom:20px;}";
  html += ".label{color:#94a3b8;font-size:13px;}";
  html += ".value{font-size:26px;font-weight:bold;}";
  html += ".risk{display:inline-block;padding:6px 14px;border-radius:8px;font-weight:bold;";
  html += "color:#fff;background:" + statusColor + ";}";
  html += ".warn{color:#fca5a5;font-weight:bold;}";
  html += "</style></head><body>";

  html += "<h1>JAL-RAKSHAK</h1>";
  html += "<div class='sub'>Water Monitoring &amp; Alert System &mdash; auto-refreshes every 3s</div>";

  if (sensorError)
  {
    html += "<div class='card'><span class='warn'>WARNING: HC-SR04 timeout / no echo received. ";
    html += "Water level reading may be invalid.</span></div>";
  }

  html += "<div class='card'><div class='label'>Risk Status</div>";
  html += "<span class='risk'>" + riskStatus + " (" + String(riskScore, 0) + "/100)</span></div>";

  html += "<div class='card'><div class='label'>Water Level</div>";
  html += "<div class='value'>" + String(waterLevel, 1) + " cm</div></div>";

  html += "<div class='card'><div class='label'>Raw Distance (HC-SR04)</div>";
  html += "<div class='value'>" + String(distanceCM, 1) + " cm</div></div>";

  html += "<div class='card'><div class='label'>Temperature</div>";
  html += "<div class='value'>" + String(temperatureC, 1) + " &deg;C</div></div>";

  html += "<div class='card'><div class='label'>Rain Status</div>";
  html += "<div class='value'>" + String(rainDetected ? "RAIN DETECTED" : "NO RAIN") + "</div></div>";

  html += "<div class='card'><div class='label'>Vibration</div>";
  html += "<div class='value'>" + String(vibrationDetected ? "DETECTED" : "NONE") + "</div></div>";

  html += "<div class='card'><div class='label'>Water Level Rate of Change</div>";
  html += "<div class='value'>" + String(rateOfChange, 3) + " cm/s</div></div>";

  html += "<div class='sub'>Wi-Fi: " + WiFi.SSID() + " &nbsp;|&nbsp; IP: " + WiFi.localIP().toString() + "</div>";

  html += "</body></html>";

  server.send(200, "text/html", html);
}

void handleNotFound()
{
  server.send(404, "text/plain", "Not found");
}

void setupWebServer()
{
  server.on("/", handleRoot);
  server.onNotFound(handleNotFound);
  server.begin();

  Serial.println("Web server started.");
}


// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("=================================");
  Serial.println("      JAL-RAKSHAK STARTING");
  Serial.println("=================================");


  // ----------------------------------------------------------
  // SENSOR PINS
  // ----------------------------------------------------------

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(RAIN_AO, INPUT);

  pinMode(VIBRATION_PIN, INPUT);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);


  // ----------------------------------------------------------
  // I2C LCD
  // ----------------------------------------------------------

  Wire.begin(SDA_PIN, SCL_PIN);

  lcd.init();
  lcd.backlight();
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("JAL-RAKSHAK");

  lcd.setCursor(0, 1);
  lcd.print("Starting...");


  // ----------------------------------------------------------
  // SIM800L
  // ----------------------------------------------------------

  initializeSIM800();


  // ----------------------------------------------------------
  // WIFI
  // ----------------------------------------------------------

  connectWiFi();


  // ----------------------------------------------------------
  // WEB SERVER
  // ----------------------------------------------------------

  if (WiFi.status() == WL_CONNECTED)
  {
    setupWebServer();
  }


  // ----------------------------------------------------------
  // INITIAL WATER READING
  // ----------------------------------------------------------

  distanceCM =
      readDistance();

  waterLevel =
      calculateWaterLevel(distanceCM);

  previousWaterLevel =
      waterLevel;

  previousTime =
      millis();


  delay(2000);


  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("System Ready");

  lcd.setCursor(0, 1);
  lcd.print("Monitoring...");


  delay(2000);


  Serial.println();
  Serial.println("SYSTEM READY");

  if (WiFi.status() == WL_CONNECTED)
  {
    Serial.print("Open dashboard at: http://");
    Serial.println(WiFi.localIP());
  }
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  unsigned long currentTime =
      millis();


  // ----------------------------------------------------------
  // HANDLE INCOMING WEB REQUESTS
  // Must be called every loop iteration with no long blocking
  // delays before it, or the page will hang/timeout.
  // ----------------------------------------------------------

  server.handleClient();


  // ----------------------------------------------------------
  // BUZZER ALARM (non-blocking, runs every loop iteration so
  // beeping stays responsive even between sensor cycles)
  // ----------------------------------------------------------

  updateBuzzer();


  // ----------------------------------------------------------
  // READ SENSORS EVERY 3 SECONDS
  // ----------------------------------------------------------

  if (
    currentTime - previousTime
    >= SENSOR_INTERVAL
  )
  {
    float dt =
      (currentTime - previousTime)
      / 1000.0;

    previousTime =
      currentTime;


    // --------------------------------------------------------
    // WATER LEVEL
    // --------------------------------------------------------

    distanceCM =
      readDistance();

    waterLevel =
      calculateWaterLevel(
        distanceCM
      );


    // --------------------------------------------------------
    // TEMPERATURE
    // --------------------------------------------------------

    temperatureC =
      readTemperature();


    // --------------------------------------------------------
    // RAIN
    // --------------------------------------------------------

    readRainSensor();


    // --------------------------------------------------------
    // VIBRATION
    // --------------------------------------------------------

    readVibrationSensor();


    // --------------------------------------------------------
    // WATER BEHAVIOR
    // --------------------------------------------------------

    calculateWaterRate(
      waterLevel,
      dt
    );


    // --------------------------------------------------------
    // RISK
    // --------------------------------------------------------

    riskScore =
      calculateRisk();

    riskStatus =
      getRiskStatus(
        riskScore
      );


    // --------------------------------------------------------
    // SERIAL MONITOR
    // --------------------------------------------------------

    printSerial();


    // --------------------------------------------------------
    // LCD
    // --------------------------------------------------------

    displayLCD();


    // --------------------------------------------------------
    // SMS ALERT
    // --------------------------------------------------------

    checkSMSAlert();


    // --------------------------------------------------------
    // UPDATE PREVIOUS WATER LEVEL
    // --------------------------------------------------------

    previousWaterLevel =
      waterLevel;
  }


  // ----------------------------------------------------------
  // SEND TO THINGSPEAK EVERY 15 SECONDS
  // ----------------------------------------------------------

  if (
    currentTime - lastThingSpeakUpdate
    >= THINGSPEAK_INTERVAL
  )
  {
    lastThingSpeakUpdate =
      currentTime;

    sendToThingSpeak();
  }


  // ----------------------------------------------------------
  // SEND DATA TO JAL RAKSHAK BACKEND EVERY 5 SECONDS
  // ----------------------------------------------------------

  if (
    currentTime - lastBackendUpdate
    >= BACKEND_INTERVAL
  )
  {
    lastBackendUpdate = currentTime;

    sendToBackend();
  }
}

